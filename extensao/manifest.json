{
  "manifest_version": 3,
  "name": "Luméra CRM · WhatsApp Web",
  "version": "1.0.0",
  "description": "Botão \"Enviar ao CRM\" dentro do WhatsApp Web. Só envia quando a recepção clica; não lê nem manda mensagens sozinho.",
  "icons": { "16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png" },
  "action": { "default_popup": "popup.html", "default_title": "Configurar Luméra CRM" },
  "background": { "service_worker": "background.js" },
  "permissions": ["storage"],
  "host_permissions": ["https://web.whatsapp.com/*", "https://lumeraodonto.vercel.app/*", "https://*.vercel.app/*"],
  "content_scripts": [{ "matches": ["https://web.whatsapp.com/*"], "js": ["content.js"], "run_at": "document_idle" }]
}
